# ============================================
# MyClasses Backend - Environment Variables
# ============================================
# For Digital Ocean App Platform:
# Copy these values into App Settings → Environment Variables
# Mark sensitive values (marked with 🔒) as SECRET in DO UI
# ============================================

# --- Server ---
SERVER_PORT=8080

# --- Database (Digital Ocean Managed PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db-postgresql-blr1-97829-do-user-37647391-0.k.db.ondigitalocean.com:25060/defaultdb?sslmode=require
SPRING_DATASOURCE_USERNAME=doadmin
# 🔒 Replace with your actual DO managed DB password
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_DO_DB_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# --- JPA / Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- JWT ---
# 🔒 Replace with a strong random secret for production
JWT_SECRET=IPh0QiYq8RN+40oPeT2Yy6jxTuewduD/DWUCnWF5Dcw=
JWT_EXPIRATION=86400000

# --- AWS S3 ---
AWS_S3_BUCKET_NAME=myclassesimages
AWS_S3_REGION=ap-south-1
# 🔒 Replace with your actual AWS credentials
AWS_ACCESS_KEY=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_KEY=REPLACE_WITH_AWS_SECRET_KEY

# --- File Upload ---
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB
